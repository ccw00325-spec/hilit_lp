# 윤문 작업 중간 산출물. 결과물은 index.html 에 이미 반영돼 있다.
_workspace/

# ---------------------------------------------------------------------------
# 데모 영상과 추출 프레임은 커밋하지 않는다.
#
# 실제 피겨 강습 장면이고 미성년자로 보이는 인원이 담겨 있다.
# 이 저장소는 공개이고, 공개 저장소에 한번 올라간 파일은 git 이력·포크·
# 캐시에 남아 회수가 어렵다.
#
# 로컬에서 데모를 보려면 이 경로에 파일을 두면 된다 (README 참조).
#   assets/hilit-demo.mp4
#   assets/tracking-debug.mp4
#   assets/video-frames/frame-*.png
# ---------------------------------------------------------------------------
assets/*.mp4
assets/video-frames/

# 다만 아래 배경 영상은 커밋한다. 실제 인물이 아니라 생성된 CG 클립이라 위의 사유가
# 걸리지 않고, 랜딩이 이 파일에 기대므로 없으면 페이지가 비어 보인다.
!assets/hero-hockey.mp4
!assets/highlight-editor.mp4
!assets/basketball-arena.mp4
!assets/basketball-aerial.mp4
!assets/soccer-thermal.mp4
!assets/hero-tracking.mp4
!assets/my-record.mp4
!assets/figure-ice.mp4
!assets/record-flow.mp4

# 같은 이유로 원본 샘플 영상도 커밋하지 않는다.
docs/샘플영상/

# 앱 프로토타입 캡처도 같은 이유로 커밋하지 않는다.
# 실물 앱(ui-hilit)을 그대로 찍은 화면이라 실제 인물 얼굴이 담긴다.
# lp-v2.html 이 이 경로를 참조하지만, 파일이 없어도 페이지는 열린다.
assets/prototype/

# 도구가 만드는 것
node_modules/
*.log
.DS_Store
.vercel
.env*
