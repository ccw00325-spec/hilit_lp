# lp-v5 랜딩 배포에 필요한 것만 올린다.
#   lp-v5.html · tokens.css · login.html · assets/

# ---------------------------------------------------------------------------
# 실제 인물(미성년자로 보이는 인원 포함)이 담긴 원본 영상·캡처.
# .gitignore 와 같은 사유로 공개 배포에도 올리지 않는다.
# ---------------------------------------------------------------------------
피겨.mov
피겨ai영상.png
하키영상2.png
배경영상1.mp4
assets/prototype/
assets/video-frames/
docs/

# .gitignore 와 같은 정책: assets 의 영상은 기본 제외하고,
# 실제 인물이 아닌 생성 CG 배경 클립만 배포한다.
# 🔴 lp-v5 가 참조하는 영상은 빠짐없이 여기 있어야 한다 — 하나라도 빠지면
#    그 패널 배경만 조용히 비어 배포된다(깨진 자리가 아니라 검은 자리라 눈에 안 띈다).
assets/*.mp4
!assets/hero-tracking.mp4
!assets/basketball-arena.mp4
!assets/figure-ice.mp4
!assets/my-record.mp4
!assets/soccer-thermal.mp4
!assets/basketball-aerial.mp4
!assets/hero-hockey.mp4

# 작업 중간 산출물
.preview-persona.html
.preview-pricing.html
.preview-probe.html
요금제 적용.html
워딩 수정.html
하이라이트구간.html
_workspace/

# lp-v5 는 브라우저 추적 데모를 뺐으므로 모델·엔진 파일이 필요 없다 (약 28MB 절약)
weights/
engine/
tools/
experience.js
serve.mjs
start-demo.cmd

# index.html 을 빼야 vercel.json 의 `/` → lp-v5.html rewrite 가 동작한다.
# Vercel 은 정적 파일 매칭을 rewrite 보다 먼저 하므로 루트에 index.html 이 있으면
# 그 파일이 먼저 잡힌다. 게다가 index.html 은 experience.js·engine·weights 에
# 기대는 앱 데모라 위에서 그것들을 뺀 이 배포에서는 어차피 정상 동작하지 않는다.
index.html

# 도구가 만드는 것
node_modules/
*.log
.DS_Store
